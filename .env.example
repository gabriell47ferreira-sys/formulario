PORT=3001
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change_this_password_in_production
JWT_SECRET=change_this_secret_in_production_key_minimum_32_chars

# 4CETY Local Database & Storage Configuration
CETY_DB_PATH=data/cety.sqlite
CETY_STORAGE_DIR=storage/pdfs
CETY_BACKUP_DIR=backups
MAX_PDF_SIZE_MB=10

# Vercel & Integration Security Configuration
# CORS: Comma-separated list of allowed origins or empty for defaults (localhost + *.vercel.app)
CORS_ALLOWED_ORIGIN=https://seu-projeto.vercel.app,http://localhost:5173

# Frontend API URL (Configured in Vercel environment settings to point to your secure local tunnel)
VITE_API_URL=https://api-tunnel.seu-dominio.com
